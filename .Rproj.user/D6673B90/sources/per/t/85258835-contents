double pcss(Eigen::VectorXd y, Eigen::VectorXd mu, int p) {
  int N = y.size();
  double fi = 0.0;

  for (int i = 0; i < N; ++i) {
    double nr = pow(y[i] - mu[i], 2);
    double dr = mu[i] * (N - p);
    fi += nr / dr;
  }

  return fi;
}

