  XtW <- t(Gae2) * resultwii
  approximate_var <- XtW %*% Gae2
  X2df[i] <- t(Tscore) %*% solve(approximate_var) %*% Tscore

  p[i] <- 1 - pchisq(X2df[i], 1)
}
