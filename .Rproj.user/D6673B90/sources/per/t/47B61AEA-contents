#高斯
n <- 500
m <- 200
repetitions <- 100
environment <- rep(c(rep(0, n), rep(1, n)), 1)
X1 <- rbinom(n, 1, 0.5)
X2 <- rnorm(n, 0, 1)
X <- cbind(X1, X2)
X <- rbind(X,X)

coldx <- c("SNP25","SNP67", "SNP124", "SNP185")
coldp <- c("SNP25:0","SNP25:1", "SNP67:0","SNP67:1", "SNP124:0","SNP124:1", "SNP185:0","SNP185:1")
d1x <- matrix(NA, nrow = repetitions, ncol = 4)
d1p <- matrix(NA, nrow = repetitions, ncol = 8)
colnames(d1x) <- coldx
colnames(d1p) <- coldp
num <- m*(m-1)/2
coldx2 <- c("SNP17_SNP124","SNP46_SNP163", "SNP118_SNP200")
coldp2 <- c("SSNP17_SNP124:0","SNP17_SNP124:1", "SNP46_SNP163:0","SNP46_SNP163:1", "SNP118_SNP200:0","SNP118_SNP200:1")
d2x <- matrix(NA, nrow = repetitions, ncol = 3)
d2p <- matrix(NA, nrow = repetitions, ncol = 6)
colnames(d2x) <- coldx2
colnames(d2p) <- coldp2
indices_a <- c(25,67,124,185)
col_indices <- c(3171,8082 ,16579)
h2 <- 0.6
vpop <- sqrt(0.05)
xc <- c(vpop,vpop)
g_pop <- X %*% xc
va <- sqrt(0.20)
vah <- sqrt(0.25)
vaa <- sqrt(0.30 )
vaah <- sqrt(0.25 )
start_time <- Sys.time()
power_loose <- numeric(4)
power_strict <- numeric(4)
power_selection <- numeric(4)
power_aa_loose <- numeric(3)
power_aa_strict <- numeric(3)
power_aa_selection <- numeric(3)

f1 <- 0
t1 <- 0
f2 <- 0
t2 <- 0
f3 <- 0
t3 <- 0
faa1 <- 0
taa1 <- 0
faa2 <- 0
taa2 <- 0
faa3 <- 0
taa3 <- 0
for (rep in 1:repetitions ) {
  Ga <- matrix(NA, n, m)
  freq <- runif(m, 0.05, 0.5)
  for (i in 1:m) {
    Ga[, i] <- rbinom(n, 2, freq[i])
    #Ga[, i] <- Ga[, i] - 1
  }
  Ga <- calculate_Xs(Ga)
  colnames(Ga) <- paste0("SNP", 1:m)
  Gaa <- matrix(NA, n, 3)
  Gaa[, 1] <- Ga[, 17] * Ga[, 124]
  Gaa[, 2] <- Ga[, 46] * Ga[, 163]
  Gaa[, 3] <- Ga[, 118] * Ga[, 200]

  ia <- c(25, 67, 124)
  ba1 <- c(va,va,va)
  ga1 <- Ga[,ia] %*% ba1
  #ba2 <- c(va,va,va)
  ga2 <- Ga[,ia] %*% ba1

  iah <- c(67, 185)
  bah1 <- c(-vah,-vah)
  gah1 <- Ga[,iah] %*% bah1
  bah2 <- c(vah,vah)
  gah2 <- Ga[,iah] %*% bah2

  baa1 <- c(vaa,vaa)
  gaa1 <- Gaa[,c(1,3)] %*% baa1
  baa2 <- c(vaa,vaa)
  gaa2 <- Gaa[,c(1,3)] %*% baa2

  baah1 <- c(-vaah,-vaah)
  gaah1 <- Gaa[,c(2,3)] %*% baah1
  baah2 <- c(vaah,vaah)
  gaah2 <- Gaa[,c(2,3)] %*% baah2

  ga <- c(ga1,ga2)
  gah <- c(gah1,gah2)
  gaa <- c(gaa1,gaa2)
  gaah <- c(gaah1,gaah2)

  var_e <- (1/h2 - 1) *(var(ga)+var(gah) +var(gaa) +var(gaah) )-var(g_pop)
  error <- rnorm(2*n, sd = sqrt(var_e))
  eta <- g_pop +ga + gah +gaa + gaah  + error

  ra1 <- single.snp.score(phenotype = eta,covariate = X,environment = environment,genodata = Ga,family="gaussian")
  p1 <- ra1$p_values
  significant_l_indices <- which( p1 <= 0.5/m)
  significant_s_indices <- which( p1 <= 0.1/m)
  ra11 <- single.snp.estimate(phenotype = eta, covariate =  X,environment = environment,
                              genodata = Ga,Pvalues = p1, Bonferr = 1, family = "gaussian",
                              selection = TRUE,estimate = FALSE, GEI_random = FALSE)
  if(is.null(ra11)){
    significant_e_indices <- NULL
  }else{
    p1name <- ra11[["significant_SNP"]]
    significant_e_indices <- ra11[["fin"]]
  }

  t1 <- t1 + length(significant_l_indices )
  f1 <- f1 + length(setdiff(significant_l_indices , indices_a))
  t2 <- t2 + length(significant_s_indices )
  f2 <- f2 + length(setdiff(significant_s_indices , indices_a))
  t3 <- t3 + length(significant_e_indices )
  f3 <- f3 + length(setdiff(significant_e_indices , indices_a))
  #significant_e_indices <- match(p1name, colnames(Ga))
  if (length(significant_e_indices) > 0) {
    raa2 <- epi.snp.score(significantASNP = p1name, phenotype = eta,covariate = X,environment = environment,genodata = Ga, family="gaussian")
    p2 <- raa2$p_values
    raa22 <- epi.snp.estimate(significantASNP = p1name, phenotype = eta, covariate =  X,
                              environment = environment, genodata = Ga,Pvalues = p2, Bonferr = 0.5,
                              family = "gaussian", selection = TRUE,estimate = TRUE,GEI_random = TRUE)
  }else{
    raa2 <- epi.snp.score(phenotype = eta,covariate = X,environment = environment,genodata = Ga, family="gaussian")
    p2 <- raa2$p_values
    raa22 <- epi.snp.estimate(phenotype = eta, covariate =  X,environment = environment,
                              genodata = Ga,Pvalues = p2, Bonferr = 0.5, family = "gaussian",
                              selection = TRUE,estimate =TRUE, GEI_random = TRUE)
  }
  if(is.null(raa22)){
    significant_aa_e_indices <- NULL
  }else{
    significant_aa_e_indices <- raa22[["fin"]]
    fixp <- raa22[["fix_coefficients"]]
    randomp <- raa22[["random_coefficients"]]

    fixname <- names(fixp)
    raname <- names(randomp)

    for (i in 1:length(coldx)) {
      idx <- match(coldx[i], fixname)
      if (!is.na(idx)) {
        d1x[rep, i] <- fixp[idx]
      }
    }
    for (i in 1:length(coldx2)) {
      idx <- match(coldx2[i], fixname)
      if (!is.na(idx)) {
        d2x[rep, i] <- fixp[idx]
      }
    }

    for (i in 1:length(coldp)) {
      idx <- match(coldp[i], raname)
      if (!is.na(idx)) {
        d1p[rep, i] <- randomp[idx]
      }
    }
    for (i in 1:length(coldp2)) {
      idx <- match(coldp2[i], raname)
      if (!is.na(idx)) {
        d2p[rep, i] <- randomp[idx]
      }
    }
  }
  significant_aa_l_indices <- which( p2 <= 0.5/num)
  significant_aa_s_indices <- which( p2 <= 0.1/num)
  taa1 <- taa1 + length(significant_aa_l_indices )
  faa1 <- faa1 + length(setdiff(significant_aa_l_indices , col_indices))
  taa2 <- taa2 + length(significant_aa_s_indices )
  faa2 <- faa2 + length(setdiff(significant_aa_s_indices , col_indices))
  taa3 <- taa3+ length(significant_aa_e_indices )
  faa3 <- faa3 + length(setdiff(significant_aa_e_indices , col_indices))

  for (j in 1:length(indices_a)) {
    if (indices_a[j] %in% significant_l_indices) {
      power_loose[j] <- power_loose[j] + 1
    }
  }
  for (j in 1:length(indices_a)) {
    if (indices_a[j] %in% significant_s_indices) {
      power_strict[j] <- power_strict[j] + 1
    }
  }
  for (j in 1:length(indices_a)) {
    if (indices_a[j] %in% significant_e_indices) {
      power_selection[j] <- power_selection[j] + 1
    }
  }
  for (j in 1:length(col_indices)) {
    if (col_indices[j] %in% significant_aa_l_indices) {
      power_aa_loose[j] <- power_aa_loose[j] + 1
    }
  }
  for (j in 1:length(col_indices)) {
    if (col_indices[j] %in% significant_aa_s_indices) {
      power_aa_strict[j] <- power_aa_strict[j] + 1
    }
  }
  for (j in 1:length(col_indices)) {
    if (col_indices[j] %in% significant_aa_e_indices) {
      power_aa_selection[j] <- power_aa_selection[j] + 1
    }
  }

}
